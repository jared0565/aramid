graph-out/
.graphite*/
.cache/
.aramid/
__pycache__/
*.pyc
.superpowers/
*.egg-info/
# Packaging output. `python -m build` / `pip wheel` write these, and the
# release workflow builds into dist/ -- without these entries a maintainer who
# builds a wheel gets a dirty tree and can commit artifacts by accident.
build/
dist/
# Coverage data and the unit-suite coverage JSON scripts/latent_mutants.py
# reads; a local measurement must not dirty the tree.
.coverage
cov-unit.json

# Graphite
**/.cache/graphite/
**/.graphite/
.graphite-daemon/

# Claude Code: shared settings.json is tracked (graphite-first hook wiring);
# settings.local.json is personal machine state.
.claude/settings.local.json

# Editor state, per-developer. Not tracked for the same reason as
# settings.local.json: it says nothing about the project.
.vscode/
.graphite*

.githooks/

!/.vscode/
/.vscode/*
!/.vscode/tasks.json
